{
  "description": "agent-tunes: start music while the agent works, stop when it settles. The behaviour lives in ~/.agent-tunes/bin/agent-tunes, which install.sh links to your clone. These hooks only report when work starts and stops.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agent-tunes/bin/agent-tunes\" start",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agent-tunes/bin/agent-tunes\" start",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agent-tunes/bin/agent-tunes\" stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.agent-tunes/bin/agent-tunes\" stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
