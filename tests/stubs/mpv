#!/usr/bin/env bash
# Silent stand-in for mpv. Records how it was invoked, creates the IPC socket
# the real one would, and stays alive until killed so that process-liveness
# checks behave the same. Makes no sound.
set -u
: "${TUNES_TEST_DIR:?stub requires TUNES_TEST_DIR}"

# A probe (--frames=1) asks whether a file is playable and how long it is, so
# it answers and exits rather than blocking. It is deliberately not recorded in
# player-args, which counts playback launches. The filename drives the answer:
# "noaudio" reports a file with no sound in it, "unplayable" reports a file the
# player cannot open at all, and anything else is a fixed hour of audio, which
# gives the random-offset maths something to work with.
for a in "$@"; do
  [ "$a" = "--frames=1" ] || continue
  f="${*: -1}"
  case "$f" in
    *unplayable*) exit 1 ;;
    *noaudio*)    echo "DUR=3600.000000 AID=no"; exit 0 ;;
    *)            [ -e "$f" ] || exit 1; echo "DUR=3600.000000 AID=1"; exit 0 ;;
  esac
done

printf '%s\n' "$*" >>"$TUNES_TEST_DIR/player-args"
: >"$TUNES_TEST_DIR/playing"
sock=""
for a in "$@"; do case "$a" in --input-ipc-server=*) sock="${a#*=}" ;; esac; done
if [ -n "$sock" ]; then
  python3 - "$sock" <<'PY' 2>/dev/null
import os, socket, sys
p = sys.argv[1]
try:
    os.unlink(p)
except OSError:
    pass
s = socket.socket(socket.AF_UNIX)
s.bind(p)
s.listen(1)
PY
fi
cleanup() { rm -f "$TUNES_TEST_DIR/playing"; exit 0; }
trap cleanup TERM INT
while :; do sleep 0.2; done
