{
  "description": "agent-tunes — start background music while the agent works, stop when it settles. All logic lives in ~/agent-tunes/bin/agent-tunes; these hooks only signal work start/stop.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/agent-tunes/bin/agent-tunes\" start",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/agent-tunes/bin/agent-tunes\" start",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/agent-tunes/bin/agent-tunes\" stop",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/agent-tunes/bin/agent-tunes\" stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
