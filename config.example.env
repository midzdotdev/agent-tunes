# agent-tunes settings. Sourced by bin/agent-tunes; edit and the change is live.

TUNES_VOLUME=30              # ffplay volume, 0-100
TUNES_START_DELAY=4          # seconds of continuous work before audio starts
TUNES_FADE_IN=4              # fade-in length in seconds
TUNES_FADE_OUT=1.5           # fade-out length in seconds when a turn ends
TUNES_MIN_TAIL=300           # never start within this many seconds of the end
TUNES_RESPECT_OTHER_AUDIO=1  # 0 = play even if something else is already playing
TUNES_YIELD_TO_OTHER_AUDIO=1 # 0 = keep playing when another process starts audio
TUNES_TRACK=""               # filename in audio/, or an absolute path; empty = first track found
