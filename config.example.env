# agent-tunes settings. Sourced by bin/agent-tunes; edit and the change is live.

TUNES_VOLUME=30              # player volume, 0-100
TUNES_START_DELAY=4          # seconds of continuous work before audio starts
TUNES_FADE_IN=4              # fade-in length in seconds
TUNES_FADE_OUT=1.5           # fade-out length in seconds when a turn ends
TUNES_MIN_TAIL=300           # never start within this many seconds of the end,
                             # clamped to half the track when it will not fit
TUNES_RESPECT_OTHER_AUDIO=1  # 0 = play even if something else is already playing
TUNES_YIELD_TO_OTHER_AUDIO=1 # 0 = keep playing when another process starts audio
TUNES_YIELD_SUSTAIN=1        # seconds the other audio must last before yielding
TUNES_EXTS="m4a mp3 opus webm wav flac"   # file suffixes that count as a track
TUNES_SESSION_TTL=1800       # forget a session that has not checked in for this long,
                             # so a harness that was killed cannot keep the music going
TUNES_IGNORE_PROCESSES="systemsoundserverd,PowerChime"  # never yield to these, whatever they play.
                             # systemsoundserverd plays notification chimes and system alerts,
                             # PowerChime is the sound made when you plug the charger in.
