#!/usr/bin/env python3
"""Ramp an mpv instance's volume over its JSON IPC socket, optionally quitting.

Usage: mpv-fade <socket> <from> <to> <seconds> [--quit]

Writes only — mpv's replies and event stream are ignored, so there is no
request/response parsing to get out of step with.
"""
import json
import socket
import sys
import time

STEP = 0.05  # seconds between volume updates


def main() -> int:
    path, start, end, seconds = sys.argv[1], float(sys.argv[2]), float(sys.argv[3]), float(sys.argv[4])
    quit_after = "--quit" in sys.argv[5:]

    sock = socket.socket(socket.AF_UNIX)
    sock.settimeout(2)
    try:
        sock.connect(path)
    except OSError:
        return 1  # mpv already gone; nothing to fade

    def send(command):
        sock.sendall((json.dumps({"command": command}) + "\n").encode())

    steps = max(1, int(seconds / STEP))
    try:
        for i in range(1, steps + 1):
            send(["set_property", "volume", round(start + (end - start) * i / steps, 2)])
            time.sleep(STEP)
        if quit_after:
            send(["quit"])
    except OSError:
        return 1  # mpv exited mid-fade, which is fine
    return 0


if __name__ == "__main__":
    sys.exit(main())
